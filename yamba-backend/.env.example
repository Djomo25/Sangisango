# --- Base de données ---
# Chaîne de connexion PostgreSQL (utilisée par Prisma)
# Port hôte 5433 : évite un conflit si un autre PostgreSQL local écoute déjà sur 5432
DATABASE_URL="postgresql://yamba:yamba@localhost:5433/yamba?schema=public"

# --- IA conversationnelle (Anthropic Claude) ---
ANTHROPIC_API_KEY=""

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret Meta (onglet "Paramètres de base" de l'app Meta) — sert à vérifier la
# signature X-Hub-Signature-256 des webhooks entrants. Non requis en MOCK_MODE.
WHATSAPP_APP_SECRET=""

# --- Authentification dashboard ---
JWT_SECRET=""

# --- Mode développement ---
# Si true, l'application simule les réponses de l'API Anthropic et de la WhatsApp
# Cloud API au lieu d'appeler les vraies API (utile tant que les clés ne sont pas disponibles).
MOCK_MODE=true
